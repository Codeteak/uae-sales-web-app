# Copy to .env for local development. Set the same keys in the Vercel dashboard.
# Never commit real secrets. Publishable keys are public by design; service role is not.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
# Public app origin for auth email links (no trailing slash)
VITE_APP_URL=http://localhost:8080
APP_URL=http://localhost:8080

# Server/SSR mirrors (same project; used when rendering on the server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Required for /api/cron/reminders (server-only). Do NOT prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Cron auth — set the same value in Vercel Project Settings → Environment Variables
# Vercel sends Authorization: Bearer <CRON_SECRET>
# Hobby plans allow one cron per day; enable pg_cron in Supabase (migration 0001/0004)
# for every-5-minute reminders. Vercel cron is a daily backup.
CRON_SECRET=generate-a-long-random-string
# Optional aliases also accepted:
# LOVABLE_CRON_SECRET=
# VERCEL_CRON_SECRET=

# Supabase Auth → URL Configuration:
#   Site URL = same as VITE_APP_URL (production domain when live)
#   Redirect URLs (add all you use):
#     http://localhost:8080/reset-password
#     http://localhost:8080/dashboard
#     https://YOUR_DOMAIN/reset-password
#     https://YOUR_DOMAIN/dashboard

# ── Gmail SMTP (server-only; never use VITE_ prefix) ─────────────────────────
# Single mail path for the app: src/lib/mail.server.ts → sendAppEmail()
# Used for: SMTP smoke test (/api/mail/test) + due/overdue task reminder emails (cron).
# 1) Google Account → Security → 2-Step Verification → App passwords
#    Create an app password for "Mail" and paste it as SMTP_PASS (not your normal password).
# 2) Signup confirm + password reset are sent by THIS app SMTP (not Supabase's mailer).
# 3) Smoke test: POST /api/mail/test with Bearer CRON_SECRET and { "to": "you@gmail.com" }
#
# Rate limits (in-memory, per instance): /api/auth/* , /api/mail/test , /api/cron/reminders
#
# Reminder email cadence: pg_cron creates in-app notifications every 5m; HTTP
# /api/cron/reminders (Vercel daily + any Bearer CRON_SECRET caller) sends SMTP
# for rows with email_sent_at IS NULL. Ping that URL every 5–15m for timely mail.
# Apply drizzle/migrations/0007_notification_email_sent.sql in Supabase SQL Editor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.name@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Yaadro Sales <your.name@gmail.com>"
SMTP_REPLY_TO=your.name@gmail.com

# Shown in reset/confirm emails. Match Supabase Auth → Email → OTP expiry
# (e.g. 3600 seconds → 60). Link timeout is enforced by Supabase, not this app alone.
AUTH_LINK_EXPIRY_MINUTES=60

